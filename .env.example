# Example only. The server reads environment variables, not .env automatically.
SHIELD_HOST=192.168.1.50
SHIELD_ADB_PORT=5555
ADB_PATH=adb
# Only needed for verified APK installs/upgrades, not ordinary setup or Kodi repairs.
# AAPT2_PATH=/absolute/android-sdk/build-tools/36.0.0/aapt2
# APKSIGNER_PATH=/absolute/android-sdk/build-tools/36.0.0/lib/apksigner.jar
# JAVA_PATH=/absolute/java/bin/java
KODI_PORT=8080
KODI_USERNAME=kodi
KODI_PASSWORD=
# Optional mounted SMB path. Otherwise Kodi files are accessed over ADB.
# KODI_MOUNT=/Volumes/internal/Android/data/org.xbmc.kodi/files/.kodi
# Optional Kodi Manager 0.4+ integration (widget-cache tools need 0.6+; not needed for core tools).
# KODI_MANAGER_PORT=8765
# KODI_MANAGER_TOKEN=
NVIDIA_MCP_ALLOW_WRITES=0
NVIDIA_MCP_ALLOW_PLUGIN_BROWSE=0
# Lets the model's allow_during_playback / interrupt_other_app flags take effect. Leave at 0.
NVIDIA_MCP_ALLOW_INTERRUPT=0
# Extra home-screen launchers, e.g. a third-party launcher package.
# NVIDIA_MCP_EXTRA_LAUNCHERS=
# Exact protected Kodi setting ids an agent may change (advanced; normally empty).
# NVIDIA_MCP_ALLOW_SETTINGS=
# SHA-256 signer fingerprints you trust for NEW app installs (comma-separated), or a file of them.
# NVIDIA_MCP_TRUSTED_SIGNERS=
# NVIDIA_MCP_TRUSTED_SIGNERS_FILE=/absolute/private/trusted-signers.txt
# Local backup retention on server start (0 days disables pruning).
# NVIDIA_MCP_RETENTION_DAYS=90
# NVIDIA_MCP_KEEP_FILE_BACKUPS=50
# NVIDIA_MCP_KEEP_APK_BACKUPS=3
# Backups/audit state default to a private directory in the user's app data.
# NVIDIA_MCP_STATE_DIR=/absolute/private/path
